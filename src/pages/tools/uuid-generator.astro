---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuickTips from '@/components/QuickTips.astro';
import HelpfulButton from '@/components/HelpfulButton.astro';
import ToolSEO from '@/components/ToolSEO.astro';

const tips = [
  { heading: 'v7 for database keys', body: 'UUID v7 starts with a timestamp, so new rows append to an index instead of scattering across it. v4 is random throughout.' },
  { heading: 'ULID sorts as text', body: 'Same idea as v7 but base32, so a plain string sort puts them in creation order. Useful where the key is handled as text.' },
  { heading: 'Cryptographic randomness', body: 'IDs come from the browser\'s secure random source. If it is unavailable the tool reports it rather than falling back to Math.random.' },
  { heading: 'Inspect a UUID', body: 'Paste one to read its version and variant, and the embedded creation time for v1 and v7.' },
];

const faq = [
  { question: 'Are these generated on a server?', answer: 'No. Every ID is produced in your browser from its own cryptographic random source, so nothing is transmitted and no two visitors can receive the same list.' },
  { question: 'Should I use v4 or v7?', answer: 'v7 for anything stored in a database, because its leading timestamp means inserts land at the end of the index rather than at random points in it — which is measurably cheaper at scale. v4 when you specifically want an identifier that reveals nothing about when it was made.' },
  { question: 'Does a v7 UUID leak information?', answer: 'It encodes the millisecond it was created, to a precision anyone holding the ID can read. That is the trade for sortability. If creation time is sensitive, use v4.' },
  { question: 'What is the difference between UUID v7 and ULID?', answer: 'Both are a timestamp followed by randomness. A UUID v7 is 36 hex characters with dashes and fits any UUID column; a ULID is 26 base32 characters that sorts correctly as plain text. Pick ULID when the ID travels as a string, v7 when it goes into a UUID type.' },
  { question: 'Can two of these collide?', answer: 'Not in practice. A v4 UUID has 122 random bits, and ULID and Nano ID are comparable — you would need an impractical number of IDs before a collision became likely. This is why no coordination with a server is needed.' },
  { question: 'Is a UUID safe to use as a secret?', answer: 'A v4 UUID is unguessable enough to act as a capability token, but v1 and v7 are not — their timestamps make a large part of the value predictable. For anything security-bearing, prefer a purpose-made random token.' },
];
---

<MainLayout
  title="UUID & ID Generator — Free In-Browser Tool | Toolkist"
  description="Generate UUID v4, UUID v7, ULID and Nano ID in bulk, and inspect any UUID for version and timestamp. Runs in your browser."
  alpine={false}
  faq={faq}
>
  <div class="page-shell">

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Breadcrumbs tool="UUID & ID Generator" category="Text & Data" />
        <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">UUID &amp; ID Generator</h1>
        <p class="mt-1 text-sm text-slate-500">Generate UUID v4, v7, ULID and Nano ID — and inspect any UUID you have.</p>
      </div>
      <HelpfulButton toolKey="uuid-generator" />
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

      <div class="lg:col-span-8">
        <div class="rounded-md border border-slate-200 bg-glass p-6 shadow-sm backdrop-blur-sm">

          <!-- Kind -->
          <div role="radiogroup" aria-label="Identifier type" class="mb-4 flex flex-wrap gap-2">
            {[
              { id: 'uuid-v4', label: 'UUID v4', note: 'random' },
              { id: 'uuid-v7', label: 'UUID v7', note: 'sortable' },
              { id: 'ulid',    label: 'ULID',    note: 'sortable text' },
              { id: 'nanoid',  label: 'Nano ID', note: 'short' },
            ].map((k, i) => (
              <button
                role="radio"
                data-kind={k.id}
                aria-checked={i === 0 ? 'true' : 'false'}
                class="id-kind min-h-[--tap] rounded-md border border-slate-200 px-4 py-2 text-left text-sm text-slate-600 transition-colors hover:border-purple-300"
              >
                <span class="block font-medium">{k.label}</span>
                <span class="block text-[0.68rem] text-slate-400">{k.note}</span>
              </button>
            ))}
          </div>

          <!-- Count -->
          <div class="mb-4 flex flex-wrap items-end gap-4">
            <div>
              <label for="idCount" class="mb-1.5 block text-xs font-medium text-slate-600">How many</label>
              <input type="number" id="idCount" value="10" min="1" max="1000"
                class="w-28 rounded-md border border-slate-200 bg-surface px-3 py-2 text-sm text-slate-700 focus:border-purple-400 focus:outline-none" />
            </div>

            <label class="flex min-h-[--tap] cursor-pointer items-center gap-2 text-sm text-slate-600">
              <input type="checkbox" id="idUppercase" class="h-4 w-4 rounded border-slate-300 accent-[--color-accent]" />
              <span>Uppercase</span>
            </label>

            <label class="flex min-h-[--tap] cursor-pointer items-center gap-2 text-sm text-slate-600">
              <input type="checkbox" id="idQuoted" class="h-4 w-4 rounded border-slate-300 accent-[--color-accent]" />
              <span>Quote and comma-separate</span>
            </label>

            <button id="idGenerateBtn"
              class="ml-auto min-h-[--tap] rounded-md bg-accent px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-hover">
              Generate
            </button>
          </div>

          <div class="mb-1.5 flex items-center justify-between">
            <label for="idOutput" class="text-xs font-medium text-slate-600">Output</label>
            <div class="flex gap-3">
              <button id="idCopyBtn" class="text-xs text-slate-400 hover:text-purple-600">Copy all</button>
              <button id="idDownloadBtn" class="text-xs text-slate-400 hover:text-purple-600">Download</button>
            </div>
          </div>
          <textarea id="idOutput" rows="12" readonly spellcheck="false"
            class="w-full resize-y rounded-md border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-xs text-slate-800 focus:outline-none"></textarea>

          <p id="idStatus" class="mt-3 hidden rounded-md px-4 py-3 text-sm"></p>

          <!-- Inspector -->
          <div class="mt-6 border-t border-slate-200 pt-6">
            <label for="idInspect" class="mb-1.5 block text-xs font-medium text-slate-600">Inspect a UUID</label>
            <input type="text" id="idInspect" autocomplete="off" spellcheck="false" placeholder="Paste a UUID to read its version and timestamp…"
              class="w-full rounded-md border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-xs text-slate-800 focus:border-purple-400 focus:outline-none" />
            <dl id="idInspectResult" class="mt-3 hidden gap-3 sm:grid-cols-3"></dl>
            <p id="idInspectError" class="mt-2 hidden text-sm text-rose-600"></p>
          </div>

        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-8">
          <QuickTips tips={tips} />
        </div>
      </aside>

    </div>

    <ToolSEO
      heading="About the UUID Generator"
      faq={faq}
      related={`<a href="/tools/hash-generator" class="text-purple-500 hover:underline">Hash Generator</a> · <a href="/tools/timestamp-converter" class="text-purple-500 hover:underline">Timestamp Converter</a> · <a href="/tools/json-formatter" class="text-purple-500 hover:underline">JSON Formatter</a>`}
      keywords="uuid generator, guid generator, uuid v4, uuid v7, ulid, nanoid, bulk uuid, uuid version checker"
    >
      <p slot="description" class="mb-8 text-sm leading-relaxed text-slate-600">Generate up to a thousand identifiers at once in four formats, and inspect any UUID you already have for its version, variant and — for v1 and v7 — the creation time embedded in it. The choice that matters is v4 against v7: a v4 UUID is random throughout, so it tells nobody when it was made but scatters inserts across a database index; a v7 UUID leads with a millisecond timestamp, so rows append in order at the cost of disclosing their creation time. ULID makes the same trade as v7 in a 26-character base32 form that sorts correctly as plain text. Every value comes from the browser's cryptographic random source, and if that source is unavailable the tool says so rather than quietly substituting a weaker one.</p>
    </ToolSEO>

  </div>
</MainLayout>

<style>
  .id-kind[aria-checked='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-weak);
    color: var(--color-accent-ink);
  }
  .id-kind[aria-checked='true'] span { color: inherit; }
</style>

<script>
  import { generateIds, inspectUuid, type IdKind } from '@/lib/text/hash';
  import { dl, copyWithFeedback } from '@/lib/utils';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const output    = $<HTMLTextAreaElement>('idOutput');
  const countEl   = $<HTMLInputElement>('idCount');
  const upperEl   = $<HTMLInputElement>('idUppercase');
  const quotedEl  = $<HTMLInputElement>('idQuoted');
  const status    = $('idStatus');
  const inspectEl = $<HTMLInputElement>('idInspect');
  const inspectResult = $<HTMLDListElement>('idInspectResult');
  const inspectError  = $('idInspectError');

  let kind: IdKind = 'uuid-v4';

  function showStatus(msg: string, kindOf: 'err' | 'info') {
    status.textContent = msg;
    status.className = kindOf === 'err'
      ? 'mt-3 rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700'
      : 'mt-3 rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600';
    status.classList.remove('hidden');
  }

  function generate() {
    const requested = Number(countEl.value);
    try {
      const ids = generateIds(kind, requested);
      const shaped = ids.map((id) => {
        // Nano ID's alphabet is case-sensitive, so upper-casing it would
        // produce a different (and no longer valid) identifier.
        const cased = upperEl.checked && kind !== 'nanoid' ? id.toUpperCase() : id;
        return quotedEl.checked ? `"${cased}"` : cased;
      });
      output.value = quotedEl.checked ? shaped.join(',\n') : shaped.join('\n');

      // Only a downward clamp is worth reporting. Clearing the field clamps
      // *up* to 1, and "capped at 1,000" is a confusing thing to read when
      // you asked for nothing.
      if (Number.isFinite(requested) && Math.floor(requested) > ids.length) {
        showStatus(`Generated ${ids.length.toLocaleString()} — the count is capped at 1,000 per run.`, 'info');
      } else if (upperEl.checked && kind === 'nanoid') {
        showStatus('Nano ID is case-sensitive, so uppercase is not applied — it would produce a different identifier.', 'info');
      } else {
        status.classList.add('hidden');
      }
    } catch (e) {
      output.value = '';
      showStatus(e instanceof Error ? e.message : 'Could not generate identifiers.', 'err');
    }
  }

  function inspect() {
    const value = inspectEl.value.trim();
    inspectResult.classList.add('hidden');
    inspectResult.classList.remove('grid');
    inspectError.classList.add('hidden');
    if (!value) return;

    const info = inspectUuid(value);
    if (!info.valid) {
      inspectError.textContent = 'That is not a well-formed UUID. Expected 8-4-4-4-12 hexadecimal characters.';
      inspectError.classList.remove('hidden');
      return;
    }

    const rows: [string, string][] = [
      // The nil and max UUIDs are named in the variant, which inspectUuid
      // sets for them, so the version needs no special case here.
      ['Version', String(info.version)],
      ['Variant', info.variant ?? '—'],
      ['Created', info.timestamp ?? 'not encoded in this version'],
    ];

    inspectResult.replaceChildren(...rows.map(([label, val]) => {
      const wrap = document.createElement('div');
      wrap.className = 'rounded-md border border-slate-200 bg-surface px-3 py-2';
      const dt = document.createElement('dt');
      dt.className = 'text-[0.68rem] uppercase tracking-wider text-slate-400';
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.className = 'mt-0.5 break-all font-mono text-xs text-slate-800';
      dd.textContent = val;
      wrap.append(dt, dd);
      return wrap;
    }));
    inspectResult.classList.remove('hidden');
    inspectResult.classList.add('grid');
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.id-kind')) {
    btn.addEventListener('click', () => {
      kind = btn.dataset.kind as IdKind;
      for (const b of document.querySelectorAll<HTMLButtonElement>('.id-kind')) {
        b.setAttribute('aria-checked', String(b === btn));
      }
      generate();
    });
  }

  $('idGenerateBtn').addEventListener('click', generate);
  countEl.addEventListener('change', generate);
  upperEl.addEventListener('change', generate);
  quotedEl.addEventListener('change', generate);
  inspectEl.addEventListener('input', inspect);

  $('idCopyBtn').addEventListener('click', function (this: HTMLElement) {
    copyWithFeedback(this, output.value);
  });

  $('idDownloadBtn').addEventListener('click', () => {
    if (!output.value) return;
    dl(new Blob([output.value], { type: 'text/plain' }), `${kind}.txt`);
  });

  // Generate on load so the page is useful before any interaction.
  generate();
</script>
